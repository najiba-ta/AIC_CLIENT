# ==============================================================================
# AIC_CLIENT Environment Configuration
# ==============================================================================

# Backend API Base URL (AIC_SERVER Express backend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Site Base URL (Frontend origin for routing and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-Side Admin Configuration (Never expose to browser JavaScript)
# ADMIN_API_KEY must match the key configured in AIC_SERVER/.env
ADMIN_API_KEY=your_admin_api_key_from_aic_server
ADMIN_EMAIL=admin@alhidayahcenter.org
ADMIN_PASSWORD=your_secure_admin_password_here
SESSION_SECRET=your_secure_session_secret_key_here

# Restricted Admin Registration Invitation Code
ADMIN_INVITE_CODE=your_secure_admin_invitation_code_here
